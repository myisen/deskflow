# =============================================================================
# clipshare 配置文件
# =============================================================================
# 将此文件复制为 config.yaml 并修改为实际配置。
# 配置项优先级: CLI 参数 > config.yaml > 代码默认值
# =============================================================================

# --- 网络 ---
port: 32620                    # TCP 端口 (默认 32620)
discovery_port: 54321          # UDP 广播发现端口 (默认 54321)
password: ""                   # 连接密码。所有节点必须一致。也可以通过
                               # CLIPSHARE_PASSWORD 环境变量设置

# --- 对等节点 ---
# 指定已知 peer 的 IP 地址 (自动发现不可用时使用)。
# 也可以通过 --peer 命令行参数指定。
peers:
  # - 192.168.1.50
  # - 192.168.1.51

# --- 功能开关 ---
no_file_clip: false            # 禁用文件同步 (默认启用)
no_image: false                # 禁用图片同步 (默认启用)

# --- 轮询间隔 (秒) ---
poll_interval: 0.3             # 文本剪贴板轮询间隔 (默认 0.3)
file_poll_interval: 1.0        # 文件剪贴板轮询间隔 (默认 1.0)
image_poll_interval: 0.5       # 图片剪贴板轮询间隔 (默认 0.5)

# --- 发现与重连 ---
broadcast_interval: 2.0        # UDP 广播发现间隔 (秒, 默认 2.0)
reconnect_interval: 3.0        # 重连间隔 (秒, 默认 3.0)
handshake_timeout: 5.0         # 认证握手超时 (秒, 默认 5.0)

# --- 文件传输 ---
# recv_dir: clipshare_recv     # 接收文件的存放目录
# send_file: ""                # 启动后立即发送的文件路径
# max_file_size: 2147483648    # 最大文件大小 (字节, 默认 2 GiB)

# --- 日志 ---
# log_dir: ""                  # 日志目录。Linux 默认 /var/log/clipshare，
                               # Windows 默认 logs/。设为空字符串禁用日志
# log_retention_days: 31       # 日志保留天数